{
  "marca": "Agência Datta",
  "versao": "1.0",
  "cor": {
    "oficial": {
      "verde-profundo": { "valor": "#091105", "uso": "fundo base do tema escuro" },
      "verde":          { "valor": "#00392F", "uso": "superfície de marca; nunca como texto sobre escuro" },
      "latao":          { "valor": "#C89C4F", "uso": "acento: CTA, foco, filetes, detalhe" },
      "branco":         { "valor": "#F1F1F1", "uso": "texto sobre escuro; fundo do tema claro" },
      "preto":          { "valor": "#000000", "uso": "contraste máximo, uso pontual" }
    },
    "derivada": {
      "surface":    { "valor": "#0D1A10" },
      "surface-2":  { "valor": "#12261C" },
      "fg-2":       { "valor": "#A8B0A8" },
      "fg-3":       { "valor": "#767E78" },
      "fg-4":       { "valor": "#4B534E" },
      "latao-esc":  { "valor": "#7D5F28", "uso": "latão legível sobre fundo claro" }
    },
    "semantica": {
      "sucesso":     { "escuro": "#3FB27F", "claro": "#17694A" },
      "alerta":      { "escuro": "#E8833C", "claro": "#9A5410" },
      "erro":        { "escuro": "#E0574B", "claro": "#A32E25" }
    }
  },
  "fonte": {
    "display": { "familia": "Clash Display", "pesos": [500, 600, 700], "origem": "Fontshare", "entrega": "self-hosted woff2" },
    "corpo":   { "familia": "General Sans",  "pesos": [400, 500, 600], "origem": "Fontshare", "entrega": "self-hosted woff2" },
    "mono":    { "stack": "ui-monospace, SFMono-Regular, 'JetBrains Mono', Menlo, monospace", "uso": "números, rótulos, IDs" }
  },
  "raio": { "xs": "8px", "sm": "12px", "base": "16px", "lg": "24px", "pill": "999px" },
  "espacamento": { "1": "4px", "2": "8px", "3": "12px", "4": "16px", "6": "24px", "8": "32px", "12": "48px", "16": "64px", "24": "96px" },
  "movimento": { "ease": "cubic-bezier(.22,1,.36,1)", "duracao": "200ms" },
  "layout": { "largura-maxima": "1200px" }
}
